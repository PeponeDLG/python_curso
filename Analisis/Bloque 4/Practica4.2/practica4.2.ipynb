    "si = data.Accidentado == \"Si\"\n",
    "si, no =si.value_counts()\n",
    "\n",
    "print(f\"% Accidentados: {(si*100/data.Accidentado.count())}\")\n",
    "print(f\"% No accidentados: {(no*100/data.Accidentado.count())}\")\n",
    "print(\"-- -- --\")\n",
    "h = data.Sexo == \"Hombre\"\n",
    "m = data.Sexo == \"Mujer\"\n",
    "\n",
    "print(\"Exp. media hombres: \",data[h][\"Experiencia_conductor\"].mean().__round__(2))\n",
    "print(\"Exp. media mujeres: \",data[m][\"Experiencia_conductor\"].mean().__round__(2))\n",
    "print(\"Exp. media total: \",data[\"Experiencia_conductor\"].mean().__round__(2))\n",
    "print(\"-- -- --\")\n",
    "\n",
    "experiencia = data.Experiencia_conductor.drop_duplicates().sort_values(ascending=True)\n",
    "\n",
    "medias = []\n",
    "desviaciones = []\n",
    "\n",
    "print(\"Medias y desviaciones típicas del coste por edades:\\n\")\n",
    "for e in experiencia:\n",
    "    aux = data.Experiencia_conductor == e\n",
    "    medias.append(data[aux][\"Seguro_Premium\"].mean().__round__(2))\n",
    "    desviaciones.append(data[aux][\"Seguro_Premium\"].std().__round__(2))\n",
    "\n",
    "md = pd.DataFrame()\n",
    "md[\"experiencia\"] = experiencia\n",
    "md[\"media\"] = medias\n",
    "md[\"desviacion\"] = desviaciones\n",
    "\n",
    "\n",
    "fila = md.loc[md.media.idxmax()]\n",
    "print(f\"Media máxima: {fila.media} con la edad de {fila.experiencia}\")\n",
    "fila = md.loc[md.media.idxmin()]\n",
    "print(f\"Media mínima: {fila.media} con la edad de {fila.experiencia}\")\n",
    "\n",
    "display(md.head(5))"

# Generar datos para grupo A
nota_mates_A = np.sort(np.random.randint(1, 10, 50))
nota_fisica_A = nota_mates_A + np.random.randint(-2, 1, 50)
nota_fisica_A[nota_fisica_A < 0] = 0

# Generar datos para grupo B
nota_mates_B = np.sort(np.random.randint(3, 9, 50))
nota_fisica_B = nota_mates_B + np.random.randint(-2, 2, 50)
nota_fisica_B[nota_fisica_B < 0] = 0


# mostrar arrays
print("Notas matemáticas A:", nota_mates_A)
print("Notas físicas A:", nota_fisica_A)
print("Notas matemáticas B:", nota_mates_B)
print("Notas físicas B:", nota_fisica_B)





plt.figure(figsize=(10,4))
plt.plot(nota_mates_A,label='Matemáticas A', color='blue', marker='o')
plt.plot(nota_mates_B,label='Matemáticas B', color='green', marker='x')
plt.title("Notas grupo A")
#Etiquetas de los ejes
plt.ylabel("NÍndice de alumno")
#Podemos activar la cuadrícula para facilitar la lectura de los valores.
plt.grid(True)
# Ajusta automáticamente los espacios y márgenes de la figura.
#Evita que las etiquetas de los ejes, títulos o leyendas se solapen entre sí o queden cortadas.
#Es especialmente útil cuando tienes varios subplotsAjusta automáticamente los espacios y márgenes de la figura.
plt.tight_layout()
plt.show()




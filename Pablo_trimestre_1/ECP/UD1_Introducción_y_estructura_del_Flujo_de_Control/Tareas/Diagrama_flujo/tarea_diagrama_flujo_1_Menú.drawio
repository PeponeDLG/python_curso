        <mxCell id="bGitiY5d9Tr-qdrFRTdt-38" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Diagrama de flujo 1&lt;/h1&gt;&lt;p&gt;Menú básico con 3 opciones:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1- Saludar&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2 - Despedirse&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3 - Salir del programa&lt;/p&gt;&lt;p&gt;En caso de elegir una opción inválida envía un mensaje de aviso y repite el proceso.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
